# Copy to .env and adjust. Never commit .env.
#
# Every variable the services read is listed here, including the ones with sane
# defaults — this file is the contract for what the system needs in order to run.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses a natively installed PostgreSQL 17 (see README).
# `sslmode=disable` is correct for a local server and MUST NOT be used against
# a deployed database.
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet?sslmode=disable

# Separate database for integration tests, so `npm test` never touches dev data.
# Created by `npm run db:setup`.
TEST_DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet_test?sslmode=disable

# ---------------------------------------------------------------------------
# API service (/api)
# ---------------------------------------------------------------------------
PORT=8080

# Ingestion pipeline — see docs/adr/001-ingestion-design.md.
#
# INGEST_BUFFER_SIZE is the depth of the buffered channel between the HTTP
# handler and the batch writer, counted in batches rather than readings. When it
# is full the handler sheds load with 503 + Retry-After rather than blocking or
# silently dropping: the mobile client's SQLite queue is the durable buffer, so
# backpressure belongs at the edge.
INGEST_BUFFER_SIZE=1024

# The batch writer flushes when either threshold is reached, whichever is first.
INGEST_BATCH_SIZE=500
INGEST_FLUSH_MS=250

# How long the writer is given to drain in-flight batches during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Simulator (/sim)
# ---------------------------------------------------------------------------
SIM_API_URL=http://localhost:8080
SIM_VEHICLES=10
# Trace generation is deterministic given this seed — tests depend on that.
SIM_SEED=42
SIM_TICK_MS=1000

# ---------------------------------------------------------------------------
# Phase 5 — natural-language query layer. Not used yet.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
