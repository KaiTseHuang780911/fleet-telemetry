# Copy to .env and adjust. Never commit .env.
#
# Every variable the services read is listed here, including the ones with sane
# defaults — this file is the contract for what the system needs in order to run.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses a natively installed PostgreSQL 17 (see README).
# `sslmode=disable` is correct for a local server and MUST NOT be used against
# a deployed database.
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet?sslmode=disable

# Separate database for integration tests, so `npm test` never touches dev data.
# Created by `npm run db:setup`.
TEST_DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet_test?sslmode=disable

# ---------------------------------------------------------------------------
# API service (/api)
# ---------------------------------------------------------------------------
PORT=8080

# Ingestion pipeline — see docs/adr/001-ingestion-design.md.
#
# INGEST_BUFFER_SIZE is the depth of the buffered channel between the HTTP
# handler and the batch writer, counted in batches rather than readings. When it
# is full the handler sheds load with 503 + Retry-After rather than blocking or
# silently dropping: the mobile client's SQLite queue is the durable buffer, so
# backpressure belongs at the edge.
INGEST_BUFFER_SIZE=1024

# The batch writer flushes when either threshold is reached, whichever is first.
INGEST_BATCH_SIZE=500
INGEST_FLUSH_MS=250

# How long the writer is given to drain in-flight batches during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Derivation (`npm run derive`, or `api derive`)
# ---------------------------------------------------------------------------
# Trips and stops are recomputed over a window rather than detected as readings
# arrive — a device draining an offline backlog delivers hours-old data, which a
# streaming detector would already have skipped past. See docs/adr/004.
DERIVE_LOOKBACK_MS=86400000

# Run derivation inside the API process on this interval. 0 disables it, which
# is the default: in a real deployment this is a scheduled job, and every
# replica running it would duplicate the work. Set it locally so `npm run dev`
# shows live trips without a second terminal.
DERIVE_INTERVAL_MS=0

# Detection thresholds. Untuned starting values, not measurements — see
# docs/adr/004 for what each one does and why these numbers.
DERIVE_STOP_RADIUS_M=50
DERIVE_STOP_MIN_MS=120000
DERIVE_TRIP_GAP_MS=600000
DERIVE_MATCH_MAX_DELTA_MS=120000
DERIVE_MATCH_MAX_DISTANCE_M=100

# ---------------------------------------------------------------------------
# Simulator (/sim)
# ---------------------------------------------------------------------------
SIM_API_URL=http://localhost:8080
SIM_VEHICLES=10
# Trace generation is deterministic given this seed — tests depend on that.
SIM_SEED=42
SIM_TICK_MS=1000

# Simulated time need not run at wall-clock speed. At scale 1 the simulator
# produces one second of history per second, so seeing a stop — let alone enough
# to reconcile — takes hours. A higher scale advances the simulated clock faster
# per tick; backfill starts that clock in the past so timestamps stay behind the
# server's (readings from the future are rejected, correctly) and reproduce a
# device draining an offline backlog.
#
# Example: TICK_MS=200 with SCALE=15 samples every 3 simulated seconds and
# generates roughly an hour of fleet activity every four real minutes.
SIM_TIME_SCALE=1
SIM_BACKFILL_MS=0

# ---------------------------------------------------------------------------
# Phase 5 — natural-language query layer. Not used yet.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
