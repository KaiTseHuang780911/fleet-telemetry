# Copy to mobile/.env. Expo inlines EXPO_PUBLIC_* variables at build time, so
# changing this requires restarting the bundler — it is not read at runtime.

# The API the app posts telemetry to.
#
# This is the single most common thing to get wrong in development. A phone on
# your Wi-Fi cannot reach "localhost" — that resolves to the phone itself, and
# every drain fails with a network error that looks exactly like a server that
# is down. It needs your development machine's LAN address.
#
#   Windows:  ipconfig                 -> IPv4 Address of your Wi-Fi adapter
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I
#
# The Android emulator is a separate case: 10.0.2.2 is its alias for the host
# machine's loopback, so http://10.0.2.2:8080 reaches an API on the host.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Google Maps API key, for the route map (expo-maps).
#
# Create at console.cloud.google.com -> APIs & Services -> Credentials, with
# "Maps SDK for Android" enabled. The Android SDK is not billed per map load,
# but Google still requires a Cloud project with billing enabled to issue a key.
#
# RESTRICT IT. In the key's settings choose "Android apps" and add this app's
# package name with your signing certificate's SHA-1:
#
#   com.kaitsehuang.fleettelemetry
#   keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey \
#           -storepass android -keypass android      # prints the SHA-1
#
# This matters because the key ships inside the APK -- a client-side maps SDK
# needs it on the device, so anyone with the artifact can extract it. Keeping it
# out of git protects the repository; the restriction is what protects the key.
#
# Note the release build currently signs with the DEBUG keystore, so the SHA-1
# registered now must be updated when a real release keystore is generated.
GOOGLE_MAPS_API_KEY=
