--- a/node_modules/expo-task-manager/android/src/main/java/expo/modules/taskManager/TaskManagerUtils.java
+++ b/node_modules/expo-task-manager/android/src/main/java/expo/modules/taskManager/TaskManagerUtils.java
@@ -202,7 +202,22 @@ public class TaskManagerUtils implements TaskManagerUtilsInterface {
   private JobInfo createJobInfo(int jobId, ComponentName jobService, PersistableBundle extras) {
     JobInfo.Builder jobBuilder = new JobInfo.Builder(jobId, jobService)
         .setExtras(extras)
-        .setPersisted(true)
+        // PATCHED (fleet-telemetry): was setPersisted(true).
+        //
+        // A persisted job requires RECEIVE_BOOT_COMPLETED, and JobScheduler
+        // reports a missing grant by throwing IllegalArgumentException on the
+        // main thread -- so on a ROM that declines to honour that permission,
+        // the first background location fix kills the process, and every
+        // relaunch redelivers it. The app crash-loops until the user turns
+        // device location off. Observed on OxygenOS 10 with the permission
+        // declared and reported as granted.
+        //
+        // Persistence buys almost nothing here: this is a one-shot job that
+        // hands a batch of locations to JS within seconds of being scheduled,
+        // so it only matters if the device reboots inside that gap. The cost
+        // is that background tasks do not resume by themselves after a reboot
+        // until the app is opened, which this project accepts deliberately.
+        .setPersisted(false)
         .setRequiresDeviceIdle(false);
 
     if (Build.VERSION.SDK_INT < 28) {
